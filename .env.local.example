ANTHROPIC_API_KEY=
APP_USERS=[{"username":"moises","password":"CAMBIAME","unlimited":true},{"username":"amigo1","password":"CAMBIAME1","limit":2},{"username":"amigo2","password":"CAMBIAME2","limit":2}]
# Poner en "true" para mostrar una pagina estatica "En construccion" en TODAS las rutas
# (incluidas /api/step*), sin tocar el resto del codigo. Quitarla o ponerla en cualquier
# otro valor restaura el comportamiento normal. En Vercel requiere redeploy para aplicarse.
MAINTENANCE_MODE=
# Nombres de variable segun la integracion de Upstash desde el Marketplace de Vercel.
# Puede llamarse UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, o venir con el nombre
# del store como prefijo (ej. UPSTASH_REDIS_REST_KV_REST_API_URL / _TOKEN) - revisa cuales
# aparecen realmente en tu proyecto de Vercel. El codigo acepta ambas variantes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
