ANTHROPIC_API_KEY=
# fullName: nombre y apellido completos (avatares, atribucion, correos de apelacion).
# email: opcional, solo se usa para avisarle al usuario si se le restaura una apelacion aceptada.
APP_USERS=[{"username":"moises","password":"CAMBIAME","unlimited":true,"fullName":"Moises Ramirez","email":"moises@umbusk.com"},{"username":"amigo1","password":"CAMBIAME1","limit":2,"fullName":"Juan Smith"},{"username":"amigo2","password":"CAMBIAME2","limit":2,"fullName":"Diogenes Infante"}]

# --- Compuerta de rechazo temprano (apelaciones por correo via Resend) ---
# Ya configurada en Vercel: dominio deutsch.umbusk.com verificado, remitente
# apelaciones@deutsch.umbusk.com, llave con permiso "Sending access" restringida a ese dominio.
RESEND_API_KEY=
# Opcionales: si se omiten, el codigo usa por defecto moises@umbusk.com y
# apelaciones@deutsch.umbusk.com respectivamente.
ADMIN_EMAIL=moises@umbusk.com
RESEND_FROM=apelaciones@deutsch.umbusk.com
# Secreto para firmar (HMAC-SHA256) los enlaces de restauracion de cupo que llegan por correo.
# Genera uno con: openssl rand -hex 32 -- y no lo cambies despues de emitir enlaces, o los
# enlaces ya enviados dejaran de validar.
RESTORE_LINK_SECRET=

# Poner en "true" para mostrar una pagina estatica "En construccion" en TODAS las rutas
# (incluidas /api/step*), sin tocar el resto del codigo. Quitarla o ponerla en cualquier
# otro valor restaura el comportamiento normal. En Vercel requiere redeploy para aplicarse.
MAINTENANCE_MODE=
# Nombres de variable segun la integracion de Upstash desde el Marketplace de Vercel.
# Puede llamarse UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, o venir con el nombre
# del store como prefijo (ej. UPSTASH_REDIS_REST_KV_REST_API_URL / _TOKEN) - revisa cuales
# aparecen realmente en tu proyecto de Vercel. El codigo acepta ambas variantes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
